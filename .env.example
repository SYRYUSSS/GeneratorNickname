# Скопируйте в .env на своём ПК (файл .env в Git не попадает — так и задумано).
# В GitHub Codespaces используйте Secrets или export в терминале (см. ниже).

TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_GIF=1

# Опционально:
# TELEGRAM_HTTP_PROXY=http://127.0.0.1:7890
# TELEGRAM_GIF_DELAY_CS=9
# TELEGRAM_ANIM_DELAY=0.12
